# ============================================================================
# web-search-mcp-cloak — environment configuration
# ============================================================================
# Copy this file to .env and fill in your values. .env is gitignored.

# --- Webshare proxy (optional but strongly recommended) -------------------
# Get a free token at https://proxy.webshare.io/userapi/keys
# Without a token, the server runs in "passthrough" mode (no proxy) and is
# more likely to hit Bing/Brave bot detection.
WEBSHARE_API_TOKEN=

# How often (in hours) to refresh the proxy list from Webshare.
PROXY_REFRESH_HOURS=6

# Optional comma-separated ISO country codes to filter proxies, e.g. "US,SG,JP".
# Leave empty for any country.
PROXY_COUNTRY_FILTER=

# --- Browser pool ---------------------------------------------------------
# Maximum concurrent CloakBrowser instances kept warm.
MAX_BROWSERS=3

# Set to "false" to run with a visible browser window (debugging only).
BROWSER_HEADLESS=true

# --- Search behavior ------------------------------------------------------
# Per-result content cap (characters) when fetching full pages.
MAX_CONTENT_LENGTH=10000

# Per-request timeout in milliseconds.
DEFAULT_TIMEOUT=10000

# Always run all engines and return the best results (slower, higher quality).
FORCE_MULTI_ENGINE_SEARCH=false

# Filter low-relevance results (true/false).
ENABLE_RELEVANCE_CHECKING=true

# Minimum relevance score to keep (0.0-1.0).
RELEVANCE_THRESHOLD=0.3

# Verbose Bing logs (true/false). Useful when diagnosing CAPTCHA issues.
DEBUG_BING_SEARCH=false
